# RUN: Kaleidoscope-Sec14 < %s 2>&1 | FileCheck %s
# REQUIRES: default_triple

# Test user-defined structs, ABI DataLayout offsets, GEP member access, and arrays.
def binary : 1 (x y) y;

struct Padded {
  tag: byte,
  val: i64
};

def test_struct_and_array() -> i64
  var s: Padded, arr: [3 x i64] in
  (s.tag = 2 as byte) :
  (s.val = 40 as i64) :
  (arr[0] = 10 as i64) :
  (arr[1] = 20 as i64) :
  (arr[2] = s.val + (s.tag as i64)) :
  arr[0] + arr[1] + arr[2];

test_struct_and_array();

# CHECK: Defined struct Padded (size = 16 bytes, align = 8 bytes):
# CHECK:   +0: tag
# CHECK:   +8: val
# CHECK: Evaluated to 72
