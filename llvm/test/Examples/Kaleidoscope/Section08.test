# RUN: Kaleidoscope-Sec08 < %s 2>&1 | FileCheck %s
# REQUIRES: default_triple

# Test user-defined unary and binary operators.
def unary-(x) 0 - x;
1 + (-1);
# CHECK: Evaluated to 0.000000

def binary> 10 (lhs rhs) rhs < lhs;
def clamp_ten(x) if x > 10 then 10 else x;
clamp_ten(6);
clamp_ten(25);
# CHECK: Evaluated to 6.000000
# CHECK: Evaluated to 10.000000
